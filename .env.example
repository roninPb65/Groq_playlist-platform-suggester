# Copy this file to ".env.local" for local dev, and set the same keys in Render's
# Environment tab for production. NEVER commit a filled-in version to GitHub.

# --- Auth.js (NextAuth v5) ---
# Generate a random value locally with:  openssl rand -base64 32
AUTH_SECRET=
# Required when running behind a proxy like Render
AUTH_TRUST_HOST=true
# Your deployed URL, e.g. https://resonance.onrender.com  (locally: http://localhost:3000)
AUTH_URL=http://localhost:3000

# --- Spotify (your app's credentials, from https://developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Last.fm (OPTIONAL — only needed if you wire in similarity expansion) ---
# Free key from https://www.last.fm/api/account/create
LASTFM_API_KEY=

# NOTE: There is intentionally NO Groq key here.
# Each user supplies their own Groq key at runtime in the UI; it is never stored.
