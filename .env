# Copy this file to ".env.local" for local dev, and set the same keys in Render's
# Environment tab for production. NEVER commit a filled-in version to GitHub.

# --- Auth.js (NextAuth v5) ---
# Generate a random value locally with:  openssl rand -base64 32
AUTH_SECRET=knGn3UU5hGQulsdyNTEz+Cwl3Rdg/CJKPEbzdhcW5fA=
# Required when running behind a proxy like Render
AUTH_TRUST_HOST=true
# Your deployed URL, e.g. https://resonance.onrender.com  (locally: http://localhost:3000)
AUTH_URL=https://groq-playlist-platform-suggester.onrender.com

# --- Spotify (your app's credentials, from https://developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=47bb75d43d784253ba52bfab5caa3026
SPOTIFY_CLIENT_SECRET=48ab60a40b8245b8b03dbfce62fa3d7b

# --- Last.fm (OPTIONAL — only needed if you wire in similarity expansion) ---
# Free key from https://www.last.fm/api/account/create
LASTFM_API_KEY=

# NOTE: There is intentionally NO Groq key here.
# Each user supplies their own Groq key at runtime in the UI; it is never stored.


# --- Your app's public URL (used to build the Spotify redirect for setup) ---
# Local: http://127.0.0.1:3000   Production: https://your-app.onrender.com
APP_URL=https://groq-playlist-platform-suggester.onrender.com

# --- The OWNER account's refresh token ---
# Leave blank for the first deploy. Then visit {APP_URL}/api/spotify/setup once,
# authorize with the account that should own all playlists, copy the token it
# shows you, paste it here (and in Render), and redeploy.
SPOTIFY_REFRESH_TOKEN=AQCVRIO_SJWbLCNiVvJ6g69VcoJG8xvK_tKBGviKwBbeVizlNuBao82g0yLkjxn4nDqOFdqzNwT_PRAZUhD7pof8o7f3M5Lfvbhv-xg2OgxKh6ZS9bQ0pnDK-gpjZsEUoZo
